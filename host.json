{
  "version": "2.0",
  "logging": {"logLevel": {"default": "Information", "Function": "Information"}},
  "extensionBundle": {"id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)"},
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:00:30",
      "maxDequeueCount": 5,
      "messageEncoding": "none"
    }
  }
}
